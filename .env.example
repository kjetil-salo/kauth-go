# kauth-konfig. Kopier til .env og fyll inn faktiske verdier.

# --- Database ----------------------------------------------------------
KAUTH_DB_PATH=./data/kauth.db

# --- Issuer og baseURL --------------------------------------------------
# I prod settes disse til den eksterne URL-en som er foran tunnelen.
KAUTH_ISSUER=https://auth.example.com
KAUTH_BASE_URL=https://auth.example.com

# --- RSA-nøkkelpar ------------------------------------------------------
# Generer med: openssl genpkey -algorithm RSA -out secrets/privateKey.pem -pkeyopt rsa_keygen_bits:2048
KAUTH_PRIVATE_KEY_PATH=./secrets/privateKey.pem
KAUTH_PUBLIC_KEY_PATH=./secrets/publicKey.pem

# --- OIDC state-cookie HMAC-secret --------------------------------------
# Generer med: openssl rand -base64 48
KAUTH_OIDC_STATE_SECRET=

# --- HTTP-port (default 8080) -------------------------------------------
KAUTH_HTTP_PORT=8083

# --- SMTP for magic-link ------------------------------------------------
# Eksempel for Resend; tilpass for andre leverandører.
KAUTH_SMTP_HOST=smtp.resend.com
KAUTH_SMTP_PORT=587
KAUTH_SMTP_USER=resend
KAUTH_SMTP_PASSWORD=
KAUTH_SMTP_FROM=noreply@example.com
KAUTH_SMTP_STARTTLS=true

# Sett til true i utviklingsoppsett uten SMTP — magic-link logges til stdout
# i stedet for å sendes.
# KAUTH_SMTP_MOCK=true

# Brevo-transport (BACKLOG F21) — brukes KUN for tjenester som har satt
# services.email_from_address i admin-panelet. Tomt felt = uendret rå SMTP
# over. Krever at avsenderadressens domene er Brevo-verifisert.
KAUTH_BREVO_API_KEY=

# --- Google OIDC (globale credentials, overstyres per-tjeneste i DB) -----
KAUTH_GOOGLE_CLIENT_ID=
KAUTH_GOOGLE_CLIENT_SECRET=

# --- Microsoft OIDC ----------------------------------------------------
KAUTH_MICROSOFT_CLIENT_ID=
KAUTH_MICROSOFT_CLIENT_SECRET=

# --- Lokal HTTPS-fri utvikling -----------------------------------------
# Settes til true når kauth kjøres over rein HTTP for lokal testing.
# Cookies settes da uten Secure-flagget. SKAL IKKE settes i prod.
# KAUTH_INSECURE_COOKIES=true

# --- Token-TTL (ISO 8601) ----------------------------------------------
# Per-tjeneste TTL overstyrer disse via services.access_token_ttl.
KAUTH_ACCESS_TOKEN_TTL=PT15M
KAUTH_ADMIN_TOKEN_TTL=PT8H

# --- Logging ----------------------------------------------------------
KAUTH_LOG_LEVEL=info

# --- Lyttadresse ---------------------------------------------------------
# IP-literal uten port (port settes av KAUTH_HTTP_PORT). Default 127.0.0.1, som
# passer cloudflared på samme boks. 0.0.0.0 eller :: eksponerer kauth på LAN og
# må settes eksplisitt. Vertsnavn eller ugyldig verdi stopper oppstart.
# KAUTH_HTTP_ADDR=127.0.0.1

# --- Global bryter for passord-login ------------------------------------
# Bare "true" eller "false" (tom = false); annet stopper oppstart. Når av gir
# POST /do-login 403 og passordskjemaet skjules, uansett tjenestens auth_password.
# ADVARSEL: påslag gir passordinnlogging uten rate limit (brute force er mulig),
# så bryteren bør stå av.
# KAUTH_PASSWORD_LOGIN_ENABLED=false

# --- CORS-origins for /token og /.well-known/* -------------------------
# Komma-separert, eksakt origin-match (ingen wildcard; "*" stopper oppstart). Tom = ingen CORS-headere.
# POST /token (refresh) med Origin utenfor listen får 403 {"error":"invalid_origin"}.
# Påkrevd for alle SPA-klienter som kaller POST /token for refresh — uten det
# stripper browseren responsen og refresh-flyten feiler stille.
# KAUTH_CORS_ORIGINS=https://app1.example.com,https://app2.example.com

# --- Ekstra scopes i discovery-dokumentet -------------------------------
# Komma- eller mellomromseparert. Legges til openid/email/profile i
# scopes_supported. kauth håndhever IKKE lista — scope speiles fra
# autorisasjonskoden til access-tokenet — så dette er metadata for klienter
# som leser discovery for å finne ut hva de kan be om. Bruk det for
# ressursspesifikke scopes en klient ber om sammen med en resource indicator
# (RFC 8707), der ressursserveren er den som faktisk håndhever scopet.
# KAUTH_EXTRA_SCOPES=priser:skriv
